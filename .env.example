# Copy to .env and set ONE key. Real environment variables take precedence over this file.

# Free: Google Gemini (no credit card) - https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Free: Groq (no credit card) - https://console.groq.com/keys
# GROQ_API_KEY=

# Paid: Anthropic Claude - https://console.anthropic.com
# ANTHROPIC_API_KEY=sk-ant-...

# Optional overrides
# SENTINEL_PROVIDER=gemini        # gemini | groq | ollama | anthropic | openai-compatible
# SENTINEL_MODEL=                 # leave empty to auto-pick
